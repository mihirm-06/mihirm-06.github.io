---
// A hand-edited tile: a square cover on the left, a label and a title.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tile from './Tile.astro';

interface Props {
  label: string;
  title: string;
  // file name in src/assets/now
  cover: string;
}
const { label, title, cover } = Astro.props;

const photos = import.meta.glob<ImageMetadata>('../../assets/now/*.{png,jpg,jpeg,webp,avif}', { import: 'default', eager: true });
const photo = photos[`../../assets/now/${cover}`];
if (!photo) throw new Error(`Missing cover: src/assets/now/${cover}`);
---

<Tile label={label}>
  <Fragment slot="thumb">
    <Image src={photo} alt="" widths={[128, 256]} sizes="128px" />
  </Fragment>
  <p class="t-line"><span class="t-title">{title}</span></p>
</Tile>
