---
import { getCollection } from 'astro:content';
import Tile from './Tile.astro';
import Cover from '../Cover.astro';

// the newest project that is still in progress. If none is, the newest project.
const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const project = projects.find((p) => p.data.status === 'in progress') ?? projects[0];
---

{project && (
  <Tile label="Building" href={`/projects/${project.id}`}>
    <div slot="thumb" class="cover-box">{project.data.cover && <Cover name={project.data.cover} />}</div>
    <p class="t-line"><span class="t-title">{project.data.title}</span></p>
  </Tile>
)}

<style>
  .cover-box, .cover-box :global(.cover) { width: 100%; height: 100%; }
  .cover-box :global(.cover) { aspect-ratio: auto; }
</style>
