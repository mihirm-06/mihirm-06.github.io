---
import { place } from '../data/now';
import { fetchWeather, describe, icons, type Weather } from '../lib/weather';

// Fetched while the site builds, so the first paint already has the weather. The deploy
// workflow rebuilds the site every 30 minutes, and the browser refreshes it after that.
// If the fetch fails the line starts empty and the browser fills it in.
let baked: (Weather & { at: number }) | null = null;
try {
  baked = { ...(await fetchWeather(AbortSignal.timeout(5000))), at: Date.now() };
} catch {}
const now = baked && { ...describe(baked.code, baked.day), temp: `${Math.round(baked.temp)}°F` };
---

<div class="info">
  <p class="line date">
    <span class="ico" data-daynight aria-hidden="true"></span>
    <span data-time>&nbsp;</span>
  </p>
  <p class="line weather" data-weather data-baked={baked && JSON.stringify(baked)} data-ready={now?.text ? '' : undefined}>
    <span class="ico" data-wicon aria-hidden="true" set:html={now?.icon}></span>
    <span>It's <strong data-temp>{now?.temp}</strong> and <span data-cond>{now?.text}</span> in <strong>{place.name}</strong>.</span>
  </p>
</div>

<!-- Runs as soon as the line above is parsed, so the date is there on first paint. A module
     script would wait for the whole page and its imports to load first. -->
<script is:inline define:vars={{ timeZone: place.timeZone, sun: icons.sun, moon: icons.moon }}>
  const timeEl = document.querySelector('[data-time]');
  const dayNightEl = document.querySelector('[data-daynight]');
  const clock = new Intl.DateTimeFormat('en-US', {
    weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit',
    timeZone, timeZoneName: 'short',
  });
  const hourOf = new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone });
  const tick = () => {
    const now = new Date();
    const p = Object.fromEntries(clock.formatToParts(now).map((x) => [x.type, x.value]));
    timeEl.textContent = `${p.weekday}, ${p.month} ${p.day} · ${p.hour}:${p.minute} ${p.dayPeriod} ${p.timeZoneName}`;
    // sun from 7am to 7pm, moon otherwise
    const hour = Number(hourOf.format(now));
    dayNightEl.innerHTML = hour >= 7 && hour < 19 ? sun : moon;
  };
  tick();
  setInterval(tick, 10_000);
</script>

<script>
  import { fetchWeather, describe, type Weather } from '../lib/weather';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
  // ---------- weather ----------
  const weatherEl = $('[data-weather]')!;
  const show = ({ temp, code, day }: Weather) => {
    const { text, icon } = describe(code, day);
    if (!text) return;
    $('[data-temp]')!.textContent = `${Math.round(temp)}°F`;
    $('[data-cond]')!.textContent = text;
    $('[data-wicon]')!.innerHTML = icon;
    weatherEl.dataset.ready = '';
  };

  // Use the newest answer we have: the one baked into the page at build time or the one
  // saved in this browser. Show it straight away, even if it is old, and refresh it once
  // it is more than 10 minutes old. Storage can be blocked, so every access is guarded.
  const KEY = 'weather-v4';
  type Saved = { data: Weather; at: number };
  const readSaved = (): Saved | null => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? 'null'); } catch { return null; }
  };
  const save = (data: Weather) => { try { localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), data })); } catch {} };
  const baked = JSON.parse(weatherEl.dataset.baked || 'null') as (Weather & { at: number }) | null;

  const candidates: Saved[] = [readSaved(), baked && { data: baked, at: baked.at }].filter((c): c is Saved => !!c);
  const newest = candidates.sort((a, b) => b.at - a.at)[0];
  if (newest) show(newest.data);

  if (!newest || Date.now() - newest.at > 10 * 60_000) {
    fetchWeather().then((data) => { show(data); save(data); }).catch(() => {
      // keep whatever is on screen (or nothing): the date and time still show
    });
  }
</script>

<style>
  .info { margin-top: 1.5rem; display: grid; gap: 0.55rem; }
  .line { margin: 0; display: flex; align-items: center; gap: 0.7rem; min-height: 1.5em; }
  /* the weather line keeps its space and fades in when the data arrives */
  .weather { opacity: 0; transition: opacity 400ms ease; }
  .weather[data-ready] { opacity: 1; }
  .date { color: var(--sec); }
  @media (prefers-reduced-motion: reduce) { .weather { transition: none; } }
  strong { font-weight: 700; }
  .ico { color: var(--accent-2); flex: none; width: 1.25rem; height: 1.25rem; display: inline-flex; }
  .ico :global(svg) { width: 100%; height: 100%; }
</style>
