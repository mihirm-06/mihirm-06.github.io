---
// A project's card image, from src/assets/covers.
// SVGs are inlined; photos and screenshots (png, jpg, webp, avif) are optimized
// by Astro. Everything is cropped to fill the same wide frame, so any image size
// works and cards stay the same height.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; eager?: boolean }
const { name, eager = false } = Astro.props;

const svgs = import.meta.glob<string>('../assets/covers/*.svg', { query: '?raw', import: 'default', eager: true });
const photos = import.meta.glob<ImageMetadata>('../assets/covers/*.{png,jpg,jpeg,webp,avif}', { import: 'default', eager: true });

const key = `../assets/covers/${name}`;
const svg = svgs[key];
const photo = photos[key];
if (!svg && !photo) throw new Error(`Missing cover: src/assets/covers/${name}`);
---

{svg ? (
  <div class="cover" set:html={svg} />
) : (
  <div class="cover">
    <Image src={photo!} alt="" widths={[480, 800, 1200]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 560px" loading={eager ? 'eager' : 'lazy'} />
  </div>
)}

<style>
  .cover { aspect-ratio: 28 / 15; overflow: hidden; line-height: 0; }
  .cover :global(svg), .cover :global(img) { display: block; width: 100%; height: 100%; }
  .cover :global(img) { object-fit: cover; }
</style>
