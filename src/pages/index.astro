---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Tags from '../components/Tags.astro';
import Typed from '../components/Typed.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';

const featured = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => b.data.order - a.data.order);
---

<Base>
  <section class="hero">
    <h1>{site.name}</h1>
    <Typed phrases={site.taglines} />
    {site.now && (
      <p class="now"><span class="pulse" aria-hidden="true"></span><b>Now</b><span>{site.now}</span></p>
    )}
    <div class="icons" aria-label="Contact links">
      <a href={site.links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.6 8.6h3.2V19H4.6zM6.2 3.8a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8Zm3.6 4.8H13v1.4h.1c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.9V19h-3.2v-5c0-1.2 0-2.8-1.7-2.8-1.7 0-2 1.3-2 2.7V19H9.8z" fill="currentColor"/></svg>
      </a>
      <a href={site.links.github} target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.3a9.8 9.8 0 0 0-3.1 19.1c.5.1.7-.2.7-.5v-2c-2.9.6-3.6-1.2-3.6-1.2-.4-1.1-1-1.4-1-1.4-.8-.5.1-.5.1-.5.9.1 1.4 1 1.4 1 .8 1.4 2.1 1 2.7.8.1-.6.3-1 .6-1.3-2.3-.3-4.6-1.2-4.6-5.2 0-1.1.4-2.1 1-2.9-.1-.2-.4-1.2.1-2.6 0 0 .8-.3 2.9 1.1a9.8 9.8 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.5 1.4.2 2.4.1 2.6.7.8 1 1.8 1 2.9 0 4-2.3 4.9-4.6 5.2.4.3.7 1 .7 1.9v2.9c0 .3.2.6.7.5A9.8 9.8 0 0 0 12 2.3Z" fill="currentColor"/></svg>
      </a>
      <a href={`mailto:${site.links.email}`} aria-label="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.75h18v10.5H3z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4.2 7.6 12 13.4l7.8-5.8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </a>
      <a href={site.resume} target="_blank" aria-label="Résumé">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8h8.7L19 8v12.2H6z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M14.7 3.8V8H19" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8.8 11h7.4M8.8 14h7.4M8.8 17h5.1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </a>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head"><h2>Featured projects</h2><a class="sec-link" href="/projects">All projects →</a></div>
    <div class="feature-grid">
      {featured.map((project) => <FeatureCard project={project} />)}
    </div>
  </section>

  <section class="sec" id="experience">
    <div class="sec-head"><h2>Experience</h2><a class="sec-link" href={site.resume} download>Download résumé ↓</a></div>
    <div class="split">
      {experience.map((job) => (
        <article class="split-item">
          <div class="split-head">
            <h3 class="role">{job.role}</h3>
            <p class="org">{job.org}</p>
            <p class="date">{job.dates}</p>
          </div>
          <div class="split-body">
            <ul class="bullets">{job.bullets.map((b) => <li>{b}</li>)}</ul>
            <Tags tags={job.tags} />
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero h1 { margin: 0; font-weight: 800; letter-spacing: 0.01em; line-height: 0.95; font-size: clamp(2.2rem, 5.2vw, 3.7rem); text-wrap: balance; }
  .now {
    margin: 1.1rem 0 0;
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-size: 0.9rem;
    padding: 0.45rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    max-width: 100%;
  }
  .now b { font: 400 0.66rem/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-2); }
  .now .pulse { width: 7px; height: 7px; background: var(--accent-2); flex: 0 0 auto; animation: live 1.6s ease-in-out infinite; }
  @keyframes live { 50% { opacity: 0.2; } }
  .icons { display: flex; gap: 0.9rem; margin-top: 1.2rem; }
  .icons a { color: var(--text); opacity: 0.82; display: inline-flex; transition: opacity 160ms ease, color 160ms ease; }
  .icons a:hover { opacity: 1; color: var(--accent); }
  .icons svg { width: 1.2rem; height: 1.2rem; }

  .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }

  .split { display: grid; }
  .split-item { display: grid; grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); gap: 0.8rem 3rem; padding: 1.2rem 0; }
  .split-item:first-child { padding-top: 0.6rem; }
  .role { margin: 0; font-size: 1.08rem; font-weight: 700; text-wrap: balance; }
  .org { margin: 0.25rem 0 0; opacity: 0.85; font-size: 0.95rem; }
  .split-head .date { margin-top: 0.6rem; }
  .split-body :global(.tags) { margin-top: 0.7rem; }

  @media (max-width: 760px) {
    .feature-grid { grid-template-columns: 1fr; }
    .split-item { grid-template-columns: 1fr; gap: 0.8rem; }
  }
</style>
