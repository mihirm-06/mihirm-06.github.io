---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { photos } from '../data/gallery';

// every image in src/assets/gallery, looked up by file name
const files = import.meta.glob<ImageMetadata>('../assets/gallery/*.{png,jpg,jpeg,webp,avif,gif}', { import: 'default', eager: true });
const images = await Promise.all(
  photos.map(async (photo) => {
    const src = files[`../assets/gallery/${photo.file}`];
    if (!src) throw new Error(`Gallery photo not found: src/assets/gallery/${photo.file}`);
    // a larger copy for the pop-up view
    const full = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
    return { ...photo, src, full: full.src, ratio: src.width / src.height };
  }),
);
---

<Base title="Gallery" description="Photos from rocket engine test days, hardware builds, and projects.">
  <section class="sec">
    <div class="sec-head"><h1>Gallery</h1></div>
    {images.length > 0 ? (
      <div class="rows">
        {images.map((photo, i) => (
          <figure style={`--r: ${photo.ratio.toFixed(4)}`}>
            <button
              type="button"
              class="open"
              data-index={i}
              data-full={photo.full}
              data-ratio={photo.ratio.toFixed(4)}
              data-alt={photo.alt}
              data-caption={photo.caption ?? ''}
              aria-label={`View photo: ${photo.alt}`}
            >
              <Image src={photo.src} alt={photo.alt} widths={[480, 960, 1440]} sizes={`${Math.round(photo.ratio * 320)}px`} />
              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </button>
          </figure>
        ))}
      </div>
    ) : (
      <p class="empty">Photos coming soon!</p>
    )}
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <div class="lb-inner">
      <button type="button" class="lb-close" aria-label="Close">×</button>
      <img class="lb-img" alt="" />
      <div class="lb-foot">
        <p class="lb-caption"></p>
        {images.length > 1 && (
          <div class="lb-nav">
            <button type="button" class="lb-prev" aria-label="Previous photo">←</button>
            <span class="lb-count"></span>
            <button type="button" class="lb-next" aria-label="Next photo">→</button>
          </div>
        )}
      </div>
    </div>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('.rows .open')];
  if (dialog && triggers.length) {
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count');
    let current = 0;
    const wrap = (i: number) => (i + triggers.length) % triggers.length;

    // Load and decode an image off-screen. It only goes on screen once it's fully ready,
    // so the viewer never flashes the previous photo while the next one loads.
    const cache = new Map<string, Promise<HTMLImageElement>>();
    const ready = (url: string) => {
      if (!cache.has(url)) {
        const pic = new Image();
        pic.src = url;
        cache.set(url, pic.decode().then(() => pic, () => pic));
      }
      return cache.get(url)!;
    };
    const place = async (pic: HTMLImageElement, alt: string, shown: number) => {
      const next = pic.cloneNode() as HTMLImageElement;
      next.className = 'lb-img';
      next.alt = alt;
      await next.decode().catch(() => {}); // fully ready before it goes on screen
      if (current !== shown) return; // moved on to another photo meanwhile
      dialog.querySelector('.lb-img')!.replaceWith(next);
    };

    const show = async (i: number) => {
      current = wrap(i);
      const shown = current;
      const t = triggers[current];
      const full = t.dataset.full!;
      const alt = t.dataset.alt!;
      // the grid thumbnail is already downloaded, so it's ready almost instantly
      const thumb = t.querySelector('img')?.currentSrc || full;
      const first = await ready(thumb);
      if (current !== shown) return; // clicked on to another photo meanwhile

      // size the box from the photo's shape, so the thumbnail and sharp copy fill the same space
      dialog.style.setProperty('--r', t.dataset.ratio!);
      await place(first, alt, shown);
      if (current !== shown) return;
      caption.textContent = t.dataset.caption!;
      caption.hidden = !t.dataset.caption;
      if (count) count.textContent = `${current + 1} / ${triggers.length}`;
      if (!dialog.open) dialog.showModal();

      // swap in the sharp copy once it's decoded
      if (thumb !== full) ready(full).then((sharp) => { if (current === shown) return place(sharp, alt, shown); });
      // get the neighbors ready so the arrows feel instant
      ready(triggers[wrap(current + 1)].dataset.full!);
      ready(triggers[wrap(current - 1)].dataset.full!);
    };

    triggers.forEach((t, i) => t.addEventListener('click', () => show(i)));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
    // clicking the dark area around the photo closes it
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // return focus to the photo that was opened (Esc closes natively)
    dialog.addEventListener('close', () => triggers[current].focus());
  }
</script>

<style>
  /* Justified rows: every photo starts at the same height (--h) with its own width,
     then photos in a row grow in proportion to their shape until the row is full,
     so heights stay equal and nothing is cropped. */
  .rows { --h: 240px; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  figure {
    position: relative;
    margin: 0;
    flex: var(--r) 1 calc(var(--r) * var(--h));
    /* a sparse row (like a short last row) would stretch photos huge; cap growth at 1.8x */
    max-width: calc(var(--r) * var(--h) * 1.8);
    aspect-ratio: var(--r);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }
  .open { all: unset; display: block; width: 100%; height: 100%; cursor: zoom-in; position: relative; }
  .open:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  figure :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.2rem 0.8rem 0.65rem;
    font: 400 0.7rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    /* dark fade behind the text so it stays readable on bright photos */
    background: linear-gradient(to top, rgba(10, 14, 12, 0.92) 0%, rgba(10, 14, 12, 0.78) 45%, transparent 100%);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translateY(0.4rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .open:hover figcaption, .open:focus-visible figcaption { opacity: 1; transform: none; }
  /* phones and tablets have no hover, so captions are always shown */
  @media (hover: none) { figcaption { opacity: 1; transform: none; } }

  .empty { margin: 0; color: var(--muted); }

  /* ---------- pop-up viewer ---------- */
  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(92vw, 1400px);
    max-height: 94vh;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgba(10, 14, 12, 0.88); backdrop-filter: blur(6px); }
  .lb-inner { position: relative; display: grid; gap: 0.9rem; justify-items: center; }
  .lightbox :global(.lb-img) {
    display: block;
    /* as wide as fits both the screen width and 80% of its height, at the photo's shape */
    width: min(92vw, 1400px, 80vh * var(--r, 1.5));
    aspect-ratio: var(--r, 1.5);
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .lb-foot { width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 1.5rem; }
  .lb-caption { margin: 0; color: var(--text); font-size: 0.95rem; line-height: 1.5; }
  .lb-nav { display: flex; align-items: center; gap: 0.9rem; margin-left: auto; font: 400 0.72rem/1 var(--mono); letter-spacing: 0.08em; color: var(--muted); white-space: nowrap; }
  .lb-nav button, .lb-close {
    all: unset;
    cursor: pointer;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .lb-nav button:hover, .lb-close:hover { border-color: var(--accent); }
  .lb-nav button:focus-visible, .lb-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lb-close { position: absolute; top: -0.6rem; right: -0.6rem; z-index: 1; font-size: 1.2rem; padding: 0.25rem 0.55rem; }

  @media (max-width: 760px) {
    .rows { --h: 150px; gap: 0.4rem; }
    .lb-close { top: 0.4rem; right: 0.4rem; }
    .lb-foot { flex-direction: column; gap: 0.6rem; }
  }
</style>
