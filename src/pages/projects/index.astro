---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import MultiSelect from '../../components/MultiSelect.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);

// every type and tag used by a project, most common first
const options = (pick: (p: (typeof projects)[number]) => string[]) => {
  const counts = new Map<string, number>();
  for (const p of projects) for (const v of pick(p)) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).map(([v]) => v);
};
const types = options((p) => p.data.type);
const tags = options((p) => p.data.tags);
---

<Base title="Projects" description="Projects by Mihir Mankikar: tracking systems, ML, games, and more.">
  <section class="sec">
    <div class="sec-head"><h1>Projects</h1></div>

    <div class="filters">
      <div class="filter filter-type"><MultiSelect name="type" label="Type" options={types} /></div>
      <div class="filter filter-tags"><MultiSelect name="tags" label="Tags" options={tags} /></div>
      <p class="filter-status">
        <button type="button" class="sec-link clear" hidden>Clear</button>
        <span class="count" aria-live="polite">{projects.length} projects</span>
      </p>
    </div>

    <div class="grid">{projects.map((project) => <FeatureCard project={project} />)}</div>
    <p class="none" hidden>No projects match those filters.</p>
  </section>
</Base>

<script>
  // ---------- multi-select boxes ----------
  type Box = { name: string; selected: string[]; clear: () => void };
  const boxes: Box[] = [];

  for (const root of document.querySelectorAll<HTMLElement>('.ms')) {
    const field = root.querySelector<HTMLElement>('.ms-field')!;
    const input = root.querySelector<HTMLInputElement>('.ms-input')!;
    const chips = root.querySelector<HTMLElement>('.ms-chips')!;
    const list = root.querySelector<HTMLElement>('.ms-list')!;
    const empty = root.querySelector<HTMLElement>('.ms-empty')!;
    const options = [...root.querySelectorAll<HTMLElement>('.ms-option')];
    const box: Box = { name: root.dataset.name!, selected: [], clear: () => {} };
    let active = -1;

    const visible = () => options.filter((o) => !o.hidden);
    // highlight the i-th visible option for keyboard use; null clears the highlight.
    // Numbers wrap around, so ArrowUp on the first option goes to the last.
    const setActive = (i: number | null) => {
      const vis = visible();
      options.forEach((o) => o.classList.remove('active'));
      active = i === null || !vis.length ? -1 : (i + vis.length) % vis.length;
      if (active >= 0) {
        vis[active].classList.add('active');
        vis[active].scrollIntoView({ block: 'nearest' });
        input.setAttribute('aria-activedescendant', vis[active].id);
      } else input.removeAttribute('aria-activedescendant');
    };
    const open = () => {
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      setActive(null);
    };
    const narrow = () => {
      const q = input.value.trim().toLowerCase();
      options.forEach((o) => (o.hidden = !o.dataset.value!.toLowerCase().includes(q)));
      empty.hidden = visible().length > 0;
      setActive(0);
    };
    const render = () => {
      chips.replaceChildren(
        ...box.selected.map((v) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'ms-chip';
          chip.setAttribute('aria-label', `Remove ${v}`);
          chip.textContent = v;
          const x = document.createElement('span');
          x.setAttribute('aria-hidden', 'true');
          x.textContent = '×';
          chip.append(x);
          chip.addEventListener('click', (e) => {
            e.stopPropagation();
            toggle(v);
            input.focus();
          });
          return chip;
        }),
      );
      options.forEach((o) => o.setAttribute('aria-selected', String(box.selected.includes(o.dataset.value!))));
      input.placeholder = box.selected.length ? '' : root.querySelector('.ms-list')!.getAttribute('aria-label')!;
      document.dispatchEvent(new CustomEvent('filters-changed'));
    };
    const toggle = (v: string) => {
      box.selected = box.selected.includes(v) ? box.selected.filter((s) => s !== v) : [...box.selected, v];
      render();
    };
    box.clear = () => {
      box.selected = [];
      input.value = '';
      narrow();
      render();
    };

    field.addEventListener('click', () => {
      input.focus();
      open();
    });
    input.addEventListener('focus', open);
    input.addEventListener('input', () => {
      open();
      narrow();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); open(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); open(); setActive(active === -1 ? -1 : active - 1); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const opt = visible()[active];
        if (opt) {
          toggle(opt.dataset.value!);
          input.value = '';
          narrow();
        }
      } else if (e.key === 'Escape') close();
      else if (e.key === 'Backspace' && input.value === '' && box.selected.length) toggle(box.selected.at(-1)!);
      else if (e.key === 'Tab') close();
    });
    options.forEach((o) => {
      // mousedown so the box keeps focus and stays open while picking several
      o.addEventListener('mousedown', (e) => {
        e.preventDefault();
        toggle(o.dataset.value!);
      });
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    boxes.push(box);
  }

  // ---------- filtering ----------
  // A project shows if it matches any selected type AND any selected tag.
  // A box with nothing selected doesn't filter.
  const cards = [...document.querySelectorAll<HTMLElement>('.grid .feature')];
  const count = document.querySelector<HTMLElement>('.filters .count')!;
  const clearAll = document.querySelector<HTMLButtonElement>('.filters .clear')!;
  const none = document.querySelector<HTMLElement>('.none')!;

  document.addEventListener('filters-changed', () => {
    let shown = 0;
    for (const card of cards) {
      const ok = boxes.every((b) => {
        const has: string[] = JSON.parse(card.dataset[b.name]!);
        return b.selected.length === 0 || b.selected.some((v) => has.includes(v));
      });
      card.hidden = !ok;
      if (ok) shown++;
    }
    const filtering = boxes.some((b) => b.selected.length);
    count.textContent = filtering ? `${shown} of ${cards.length} projects` : `${cards.length} projects`;
    clearAll.hidden = !filtering;
    none.hidden = shown > 0;
  });
  clearAll.addEventListener('click', () => boxes.forEach((b) => b.clear()));
</script>

<style>
  /* The filter bar uses the same columns as the card grid below, so each box
     lines up with a column of cards: Type over the first, Tags over the second,
     and the third holds Clear (next to Tags) and the project count (at the right). */
  .filters, .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .filters { row-gap: 0.75rem; align-items: start; }
  .filter-status { margin: 0; align-self: center; display: flex; gap: 1.2rem; align-items: baseline; font: 400 0.7rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .clear { background: none; border: 0; padding: 0; cursor: pointer; }
  .count { margin-left: auto; }
  .none { margin: 0; color: var(--muted); }

  @media (max-width: 1000px) {
    .filters, .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .filter-status { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .filters, .grid { grid-template-columns: 1fr; }
  }
</style>
